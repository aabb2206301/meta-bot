# =============================================================================
# Copy to `.env` for local dev if you want to point at a deployed backend
# instead of the Vite dev proxy. In Railway, set these as build-time
# environment variables on the FRONTEND service (they're baked into the JS
# at `vite build` time, so they must be set before the build runs).
# =============================================================================

# Backend's public Railway URL, no trailing slash, no /api suffix.
VITE_API_URL=https://meta-bot-production-d1da.up.railway.app

# Backend's public websocket URL, ending in /ws.
VITE_WS_URL=wss://meta-bot-production-d1da.up.railway.app/ws