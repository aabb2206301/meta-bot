# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The whole point of this app: you should only ever need to edit THIS file
# to change LLM provider, database, or channel credentials. No code changes.
# =============================================================================

# --- App ---
APP_NAME=AI Sales Agent
APP_ENV=development          # development | production
APP_DEBUG=true
BUSINESS_ID=                 # UUID of the seeded business row (fill after seeding)

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_agent
# Used by Alembic (sync driver) — same DB, different driver prefix
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sales_agent

# --- LLM provider (chat) ---
LLM_PROVIDER=groq             # groq | google
LLM_FALLBACK_ENABLED=true     # if true and both keys set, falls back on provider failure

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# --- Embeddings (product/FAQ semantic search) ---
# Groq has no embeddings endpoint, so this defaults to Google regardless
# of LLM_PROVIDER above. If GOOGLE_API_KEY is empty, the app falls back
# to Postgres ILIKE/full-text keyword search automatically.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# --- Conversation window ---
MAX_HISTORY_MESSAGES=20       # cap on messages sent to the LLM per turn

# --- WhatsApp (Meta Cloud API) ---
META_APP_SECRET=
META_VERIFY_TOKEN=            # arbitrary string you choose, used in webhook GET verification
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Instagram (Meta) ---
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# --- Facebook Messenger (Meta) ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- Rate limiting ---
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
LLM_RATE_LIMIT_PER_CONVERSATION_PER_MINUTE=10

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173

# --- JWT / dashboard auth ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRE_MINUTES=1440
